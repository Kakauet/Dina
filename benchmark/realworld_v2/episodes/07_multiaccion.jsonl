{"id":"mul-01","cat":"multiaccion","var":"es-ES","tags":["shopping"],"clock":"2026-10-05T19:00","turns":[{"u":"Apunta leche, huevos y pan.","do":["list.add 'leche'","list.add 'huevos|huevo'","list.add 'pan'"]}],"why":"Tres productos."}
{"id":"mul-02","cat":"multiaccion","var":"es-ES","tags":["timer","stt"],"clock":"2026-10-06T13:00","turns":[{"u":"pon diez minutos para la pasta y veinte para el horno","do":["timer.add 10m 'pasta'","timer.add 20m 'horno'"]}],"why":"Dos temporizadores con etiqueta (Dina 3 perdía las etiquetas)."}
{"id":"mul-03","cat":"multiaccion","var":"es-ES","tags":["stopwatch"],"clock":"2026-10-07T19:00","state":{"stopwatches":["'carrera' 32m15s"]},"turns":[{"u":"Para el crono y dime cuánto llevo.","do":["sw.pause","sw.get"]}],"why":"Acción y consulta."}
{"id":"mul-04","cat":"multiaccion","var":"es-ES","tags":["alarm"],"clock":"2026-10-08T21:30","turns":[{"u":"Pon una alarma a las siete de la mañana y otra a las siete y diez por si acaso.","do":["alarm.add 07:00","alarm.add 07:10"]}],"why":"Dos alarmas; la segunda hereda la mañana."}
{"id":"mul-05","cat":"multiaccion","var":"es-ES","tags":["volume","timer"],"clock":"2026-10-09T17:00","state":{"volume":"40"},"turns":[{"u":"Sube el volumen al máximo y pon un temporizador de cinco minutos.","do":["vol.set 100","timer.add 5m"]}],"why":"Dos dominios distintos."}
{"id":"mul-06","cat":"multiaccion","var":"es-ES","tags":["shopping","stt"],"clock":"2026-10-10T11:00","state":{"shopping":["pan","arroz","lejía"]},"turns":[{"u":"quita el arroz y añade garbanzos","do":["list.del @'arroz'","list.add 'garbanzos|garbanzo'"]}],"why":"Borrar y añadir."}
{"id":"mul-07","cat":"multiaccion","var":"es-ES","tags":["alarm"],"clock":"2026-10-11T21:00","state":{"alarms":["mañana 07:00 'trabajo'","mañana 19:00 'gimnasio'"]},"turns":[{"u":"Borra la del gimnasio y la de trabajo ponla a las siete y media.","do":["alarm.del @'gimnasio'","alarm.edit @'trabajo' at=07:30"]}],"why":"Dos acciones sobre dos alarmas distintas."}
{"id":"mul-08","cat":"multiaccion","var":"es-ES","tags":["timer"],"clock":"2026-10-12T14:00","state":{"timers":["15m 'arroz' left=9m","8m 'huevos' left=2m"]},"turns":[{"u":"Pausa los dos temporizadores.","do":["timer.pause @'arroz'","timer.pause @'huevos'"]}],"why":"Plural sobre dos elementos."}
{"id":"mul-09","cat":"multiaccion","var":"es-MX","tags":["shopping"],"clock":"2026-10-13T18:00","turns":[{"u":"Agrega jitomates, cebolla y cilantro a la lista del súper.","do":["list.add 'jitomates|jitomate'","list.add 'cebolla'","list.add 'cilantro'"]}],"why":"Vocabulario mexicano."}
{"id":"mul-10","cat":"multiaccion","var":"es-ES","tags":["alarm","datetime","stt"],"clock":"2026-10-14T22:00","turns":[{"u":"qué hora es y ponme una alarma a las seis y media de la mañana","do":["time.now time","alarm.add 06:30"]}],"why":"Consulta y acción en la misma frase."}
{"id":"mul-11","cat":"multiaccion","var":"es-ES","tags":["shopping"],"clock":"2026-10-15T19:30","turns":[{"u":"Añade dos kilos de patatas y un litro de aceite.","do":["list.add 'patatas|patata' n=2 unit=kg","list.add 'aceite' n=1 unit=l"]}],"why":"Cantidades y unidades distintas."}
{"id":"mul-12","cat":"multiaccion","var":"es-ES","tags":["timer","stopwatch"],"clock":"2026-10-16T07:00","turns":[{"u":"Arranca el cronómetro y avísame a los veinte minutos.","x":[{"do":["sw.add","timer.add 20m"]},{"do":["sw.add","alarm.in 20m"]}]}],"why":"Crono y aviso a la vez."}
{"id":"mul-13","cat":"multiaccion","var":"es-AR","tags":["shopping"],"clock":"2026-10-17T11:00","state":{"shopping":["yerba","galletitas"]},"turns":[{"u":"Sacá las galletitas y agregá pan lactal y queso.","do":["list.del @'galletitas'","list.add 'pan lactal'","list.add 'queso'"]}],"why":"Voseo con tres acciones."}
{"id":"mul-14","cat":"multiaccion","var":"es-ES","tags":["alarm","repeat","stt"],"clock":"2026-10-18T20:00","turns":[{"u":"pon una alarma de lunes a viernes a las 6 40 y otra el sábado a las nueve de la mañana","do":["alarm.add 06:40 day=mañana rep=laborables","alarm.add 09:00 day=sab"]}],"why":"Una repetida y otra puntual."}
{"id":"mul-15","cat":"multiaccion","var":"es-ES","tags":["timer"],"clock":"2026-10-19T13:00","state":{"timers":["20m 'lentejas' left=12m"]},"turns":[{"u":"Añade cinco minutos al de las lentejas y pon otro de tres para el pan.","do":["timer.plus @'lentejas' 5m","timer.add 3m 'pan'"]}],"why":"Modificar uno y crear otro."}
