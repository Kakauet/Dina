{"id":"mul-17","cat":"multiaccion","var":"es-ES","tags":["shopping","stt"],"clock":"2026-10-21T18:00","turns":[{"u":"apunta cafe azucar y leche de avena","do":["list.add 'café|cafe'","list.add 'azúcar|azucar'","list.add 'leche de avena'"]}],"why":"Lista sin comas: el producto compuesto no se parte."}
