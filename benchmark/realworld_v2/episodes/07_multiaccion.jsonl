{"id":"mul-32","cat":"multiaccion","var":"es-ES","tags":["shopping"],"clock":"2026-11-07T10:00","state":{"shopping":["leche n=1"]},"turns":[{"u":"Pon dos de leche más y añade cereales.","do":["list.edit @'leche' n=3","list.add 'cereales|cereal'"]}],"why":"Sumar a una cantidad existente."}
