{"id":"mul-19","cat":"multiaccion","var":"es-ES","tags":["calculator","stt"],"clock":"2026-10-23T12:00","turns":[{"u":"cuánto es 48 entre 4 y por 3","x":[{"do":["calc '48/4'","calc '48/4*3'"]},{"do":["calc '48/4'","calc '48*3'"]}]}],"why":"Segunda operación elíptica: sobre el resultado o sobre 48."}
{"id":"mul-20","cat":"multiaccion","var":"es-ES","tags":["alarm"],"clock":"2026-10-24T22:00","state":{"alarms":["lun 07:00 'trabajo' rep=laborables","2026-10-31 10:00","mañana 09:00 'misa'"]},"turns":[{"u":"Desactiva la de trabajo y la de mañana.","do":["alarm.off @'trabajo'","alarm.off @'misa'"]}],"why":"Dos referencias distintas en una frase."}
