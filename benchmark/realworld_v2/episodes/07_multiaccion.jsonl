{"id":"mul-22","cat":"multiaccion","var":"es-ES","tags":["shopping","timer"],"clock":"2026-10-26T18:30","turns":[{"u":"Apunta tomate frito y pon doce minutos para los macarrones.","do":["list.add 'tomate frito'","timer.add 12m 'macarrones|macarron'"]}],"why":"Compra y cocina."}
{"id":"mul-23","cat":"multiaccion","var":"es-ES","tags":["alarm","datetime","stt"],"clock":"2026-10-27T15:00","turns":[{"u":"qué día es el 4 de noviembre ponme una alarma ese día a las diez de la mañana","do":["time.weekday 2026-11-04","alarm.add 10:00 day=2026-11-04"]}],"why":"«Ese día» se refiere a la fecha de la primera parte."}
